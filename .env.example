# PayFlow configuration. Copy to `.env` only if you want to override defaults.
# The API reads process.env directly; npm scripts do not load .env automatically.

PAYFLOW_ENV=dev
PAYFLOW_HOST=0.0.0.0
PAYFLOW_PORT=4000

# SQLite file. Use an absolute path in production.
PAYFLOW_DB_PATH=./data/payflow.db

# Required in production. Hash pepper for API keys.
PAYFLOW_API_KEY_PEPPER=dev-pepper-change-me

# Worker
PAYFLOW_WORKER_ENABLED=true
PAYFLOW_WORKER_POLL_MS=400
PAYFLOW_WORKER_LEASE_SECONDS=60
PAYFLOW_MAX_JOB_ATTEMPTS=5

# Simulator controls (scenario override). Must be false in production.
PAYFLOW_ALLOW_SIMULATOR_CONTROLS=true
PAYFLOW_IDEMPOTENCY_TTL_HOURS=24

# Pagination
PAYFLOW_DEFAULT_PAGE_SIZE=25
PAYFLOW_MAX_PAGE_SIZE=100

# HTTP
PAYFLOW_CORS_ORIGIN=http://localhost:5173
PAYFLOW_RATE_LIMIT_MAX=600
PAYFLOW_LOG_LEVEL=info
